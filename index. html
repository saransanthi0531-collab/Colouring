<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Number Guessing Game</title>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: white;
    }

    /* Top App Bar */
    .topbar {
        height: 65px;
        background: #3f51b5;
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 25px;
        box-shadow: 0 2px 5px #999;
    }

    .title {
        font-size: 28px;
        font-weight: bold;
    }

    .menu {
        font-size: 30px;
    }

    /* Main Content */
    .container {
        text-align: center;
        padding-top: 120px;
    }

    .thinking {
        font-size: 24px;
        margin-bottom: 100px;
    }

    .guess-title {
        font-size: 22px;
        font-weight: bold;
        text-decoration: underline;
        margin-bottom: 20px;
    }

    /* Input */
    #guessBox {
        width: 280px;
        height: 50px;
        border: none;
        border-bottom: 2px solid #777;
        text-align: center;
        font-size: 22px;
        outline: none;
        margin-bottom: 35px;
    }

    /* Buttons */
    button {
        border: none;
        padding: 15px 28px;
        font-size: 20px;
        cursor: pointer;
        margin: 5px;
        border-radius: 4px;
        box-shadow: 0 2px 5px #aaa;
    }

    .guess-btn {
        background: #ddd;
        color: #222;
    }

    .restart-btn {
        background: red;
        color: white;
    }

    button:active {
        transform: scale(0.97);
    }

    /* Result */
    #result {
        margin-top: 30px;
        font-size: 22px;
        font-weight: bold;
        min-height: 30px;
    }

    @media (max-width: 500px) {
        .title {
            font-size: 24px;
        }

        .container {
            padding-top: 100px;
        }

        .thinking {
            font-size: 20px;
        }
    }
</style>
</head>

<body>

<!-- Top Bar -->
<div class="topbar">
    <div class="title">Number Guessing Game</div>
    <div class="menu">⋮</div>
</div>

<!-- Main Application -->
<div class="container">

    <div class="thinking">
        Thinking the number between 1 and 30...
    </div>

    <div class="guess-title">
        Guess the Number.
    </div>

    <input
        type="number"
        id="guessBox"
        min="1"
        max="30"
        placeholder=""
    >

    <br>

    <button class="guess-btn" onclick="checkGuess()">
        Guess
    </button>

    <button class="restart-btn" onclick="restartGame()">
        Restart
    </button>

    <div id="result"></div>

</div>

<script>

    // Generate a random number between 1 and 30
    let number = Math.floor(Math.random() * 30) + 1;

    function checkGuess() {

        let guess = Number(document.getElementById("guessBox").value);
        let result = document.getElementById("result");

        // Check empty input
        if (guess === 0 || document.getElementById("guessBox").value === "") {
            result.innerHTML = "Please enter a number.";
            result.style.color = "red";
            return;
        }

        // Correct answer
        if (guess === number) {

            result.innerHTML =
                "Correct! My Number was " + number;

            result.style.color = "green";
        }

        // Guess is smaller
        else if (guess < number) {

            result.innerHTML =
                "Wrong!..... My Number is higher.....";

            result.style.color = "red";
        }

        // Guess is larger
        else {

            result.innerHTML =
                "Wrong!..... My Number is lower.....";

            result.style.color = "red";
        }
    }

    // Restart the game
    function restartGame() {

        number = Math.floor(Math.random() * 30) + 1;

        document.getElementById("guessBox").value = "";

        document.getElementById("result").innerHTML = "";

        document.getElementById("guessBox").focus();
    }

</script>

</body>
</html>
